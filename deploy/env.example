# MCP bearer token. Required for remote access and whenever write/exec is enabled.
AGENT_MCP_TOKEN=

# HTTP listener.
AGENT_LISTEN_ADDR=127.0.0.1:8787

# Workspace exposed to MCP tools.
AGENT_WORKSPACE=/var/lib/gpt-go-agent/workspace

# Enable MCP file mutations explicitly.
AGENT_ALLOW_WRITE=0

# Enable restricted native command execution explicitly.
AGENT_ALLOW_COMMAND_EXEC=0

# Comma- or space-separated server allowlist. Commands must ALSO pass the
# deterministic restricted policy. Shells/interpreters/build tools are rejected.
AGENT_ALLOWED_COMMANDS=echo,uptime,pwd,date,uname,id,ls

# Audit log.
AGENT_AUDIT_PATH=/var/lib/gpt-go-agent/agent-audit.jsonl

# Webhook execution is optional and disabled by default.
AGENT_WEBHOOK_ENABLED=0
AGENT_WEBHOOK_TOKEN=
AGENT_WEBHOOK_WORKERS=4

# Durable webhook job store.
AGENT_WEBHOOK_STORE=/var/lib/gpt-go-agent/jobs/store.json

# Middleman configuration used only when webhook execution is enabled.
AGENT_MIDDLEMAN_URL=http://127.0.0.1:20128/v1
AGENT_MIDDLEMAN_KEY=
AGENT_MIDDLEMAN_MODEL=glm-5.3
AGENT_MIDDLEMAN_TIMEOUT=30s
AGENT_MIDDLEMAN_MAX_ATTEMPTS=3
AGENT_MIDDLEMAN_RETRY_BASE=250ms
AGENT_MIDDLEMAN_CIRCUIT_THRESHOLD=3
AGENT_MIDDLEMAN_CIRCUIT_OPEN=10s

# Codex is read-only by default. Enable workspace writes deliberately.
AGENT_CODEX_BIN=codex
AGENT_CODEX_ALLOW_WRITE=0

# Webhook durability and bounded execution.
AGENT_WEBHOOK_RETENTION=168h
AGENT_WEBHOOK_CLEANUP_INTERVAL=1h
AGENT_WEBHOOK_MAX_GATEKEEPER_RETRIES=2
AGENT_WEBHOOK_RETRY_BASE=500ms
AGENT_WEBHOOK_MAX_OUTPUT_BYTES=65536
