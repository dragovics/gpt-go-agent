# MCP bearer token. Required when the server is reachable beyond loopback.
AGENT_MCP_TOKEN=

# HTTP listener.
AGENT_LISTEN_ADDR=127.0.0.1:8787

# Workspace exposed to MCP tools.
AGENT_WORKSPACE=/var/lib/gpt-go-agent/workspace

# Enable mutations explicitly.
AGENT_ALLOW_WRITE=0

# Enable command execution explicitly.
AGENT_ALLOW_COMMAND_EXEC=0

# Comma- or space-separated executable allowlist.
AGENT_ALLOWED_COMMANDS=git,go,python3,npm,node,make,ls,pwd,cat,grep,find

# Audit log.
AGENT_AUDIT_PATH=/var/lib/gpt-go-agent/agent-audit.jsonl
