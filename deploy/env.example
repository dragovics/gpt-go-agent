# MCP bearer token. Required when the server is reachable beyond loopback.
AGENT_MCP_TOKEN=

# HTTP listener.
AGENT_LISTEN_ADDR=127.0.0.1:8787

# Workspace exposed to MCP tools.
AGENT_WORKSPACE=/var/lib/gpt-go-agent/workspace

# Enable mutations explicitly.
AGENT_ALLOW_WRITE=0

# Enable command execution explicitly.
AGENT_ALLOW_COMMAND_EXEC=0

# Comma- or space-separated executable allowlist.
AGENT_ALLOWED_COMMANDS=git,go,python3,npm,node,make,ls,pwd,cat,grep,find

# Audit log.
AGENT_AUDIT_PATH=/var/lib/gpt-go-agent/agent-audit.jsonl

# Durable webhook job store.
AGENT_WEBHOOK_STORE=/var/lib/gpt-go-agent/jobs/store.json

# Middleman resilience tuning.
AGENT_MIDDLEMAN_MAX_ATTEMPTS=3
AGENT_MIDDLEMAN_RETRY_BASE=250ms
AGENT_MIDDLEMAN_CIRCUIT_THRESHOLD=3
AGENT_MIDDLEMAN_CIRCUIT_OPEN=10s

# Webhook durability and bounded execution.
AGENT_WEBHOOK_RETENTION=168h
AGENT_WEBHOOK_CLEANUP_INTERVAL=1h
AGENT_WEBHOOK_MAX_GATEKEEPER_RETRIES=2
AGENT_WEBHOOK_RETRY_BASE=500ms
AGENT_WEBHOOK_MAX_OUTPUT_BYTES=65536
