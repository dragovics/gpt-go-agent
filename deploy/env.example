# Application Agents API credential.
# Must have only the permissions required by the application.
OPENAI_API_KEY=

# Restricted self-hosted executor credential.
# Inject into the executor environment as CODEX_API_KEY.
OPENAI_EXECUTOR_API_KEY=

# Agents webhook signing secret.
OPENAI_WEBHOOK_SECRET=

# Explicit model ID.
CODEX_MODEL=gpt-6-astra

# Optional paths.
CODEX_WORKSPACE=/workspace
AGENT_WEBHOOK_JOURNAL=/var/lib/gpt-go-agent/agent-webhook.jsonl
